# The morning brief's settings. Copy to .env beside compose.yaml on the machine (chmod 600)
# and fill it in; .env is never committed. A line left empty counts as not set.

# The time zone: what "this morning" means, and the times shown on the page.
TZ=Europe/Amsterdam
# When the brief is written and pushed, HH:MM in TZ.
BRIEF_TIME=07:00
# Who writes the brief. internal (the default): `serve` does it every day at BRIEF_TIME with the
# model APIs below. external: `serve` only serves the pages, and an agent on the machine writes
# the brief with `python -m brief fetch` and `ingest` (README, "Written by an agent"); the API
# keys below can then stay empty.
BRIEF_MODE=

# The models, tried in this order until one writes a usable brief. Leave a key empty to skip
# that one. With none answering, the brief is still sent: the FT's own headlines, no weights.
# Secret. Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=
# claude-opus-5-5 unless set. How hard it thinks: low, medium (the default), high, xhigh, max.
ANTHROPIC_MODEL=
ANTHROPIC_EFFORT=
# Secret. Gemini API key (aistudio.google.com). It has a free tier.
GEMINI_API_KEY=
# gemini-3.7-flash unless set.
GEMINI_MODEL=
# Secret. OpenAI API key (platform.openai.com). A ChatGPT subscription (Go, Plus) is not one.
OPENAI_API_KEY=
# gpt-5.4-mini unless set.
OPENAI_MODEL=

# Secret. The push, through ntfy.sh: https://ntfy.sh/<a long random name>. The name is the only
# thing that keeps it private, so make it long (openssl rand -hex 16) and its own. Empty: no push.
NTFY_URL=
# Secret. Only for an ntfy server that wants a token.
NTFY_TOKEN=
# Where tapping the push goes: https://brief.<tailnet>.ts.net
BRIEF_URL=

# The FT feeds read, comma-separated (https://www.ft.com/<name>?format=rss). Empty: world news,
# the regions, the economy, companies, markets, technology, climate and opinion.
FEEDS=
# 1 shows the tweaks bar on every page: fonts, sizes, colour, spacing. For design work only.
BRIEF_TWEAKS=
